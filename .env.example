# Configuration for docker-compose.yml: copy to .env and fill in.
# Never commit .env. Generate secrets with:
#   python3 -c 'from secrets import token_urlsafe; print(token_urlsafe(50))'

# Required
OSQA_SECRET_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Public address, without a trailing slash (https:// turns on secure cookies,
# HSTS and the HTTP -> HTTPS redirect).
OSQA_APP_URL=http://localhost:8000
# Host names the site answers to, comma-separated (default: the host of OSQA_APP_URL).
OSQA_ALLOWED_HOSTS=
# Port on 127.0.0.1 for the reverse proxy.
OSQA_HTTP_PORT=8000
# Reverse proxies in front of the web container that append to X-Forwarded-For.
OSQA_TRUSTED_PROXIES=1

# Dates are stored in this zone: keep the old value when moving an existing forum.
OSQA_TIME_ZONE=UTC
OSQA_LANGUAGE_CODE=en
OSQA_DISABLED_MODULES=recaptcha,project_badges

MYSQL_DATABASE=osqa
MYSQL_USER=osqa
MEMCACHED_MB=256

# json (one object per line) or text
LOG_FORMAT=json
LOG_LEVEL=INFO

# Prometheus: /metrics answers only with "Authorization: Bearer <METRICS_TOKEN>";
# empty = /metrics answers 404.
METRICS_TOKEN=

# Number of backup_site archives kept in the backups volume.
OSQA_BACKUP_KEEP=14

# Sentry (optional)
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Browser push notifications (optional; off unless both keys are set). Generate with
#   docker compose run --rm web python manage.py generate_vapid_keys --env
# and keep them: new keys make every device turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Image name when built or pulled (e.g. registry.example.org/osqa:1.4)
OSQA_IMAGE=osqa:local
