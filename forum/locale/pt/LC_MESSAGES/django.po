msgstr "Sim, cancelar inscrição"

msgid "Unsubscribe from all emails instead"
msgstr "Cancelar a inscrição em todos os e-mails"

msgid "Choose exactly which emails you get"
msgstr "Escolha exatamente quais e-mails receber"

msgid "Sign in to choose exactly which emails you get"
msgstr "Entre para escolher exatamente quais e-mails receber"

