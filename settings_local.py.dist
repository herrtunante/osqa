# encoding:utf-8
import os.path

SITE_SRC_ROOT = os.path.dirname(__file__)
LOG_DIR = os.path.join(SITE_SRC_ROOT, 'log')
LOGGING = {
    'version': 1,
    'disable_existing_loggers': False,
    'formatters': {
        'default': {
            'format': '%(asctime)s %(levelname)s %(name)s %(filename)s:%(lineno)d %(message)s',
        },
        'security': {
            'format': '%(asctime)s %(levelname)s %(message)s',
        },
    },
    'handlers': {
        # Rotated at 10 MB; the last 5 files are kept.
        'file': {
            'level': 'INFO',
            'class': 'logging.handlers.RotatingFileHandler',
            'formatter': 'default',
            'filename': os.path.join(LOG_DIR, 'django.osqa.log'),
            'maxBytes': 10 * 1024 * 1024,
            'backupCount': 5,
        },
        # Failed and paused sign-ins, password changes, refused pages,
        # permission and settings changes, blocked content (CSP).
        'security_file': {
            'level': 'INFO',
            'class': 'logging.handlers.RotatingFileHandler',
            'formatter': 'security',
            'filename': os.path.join(LOG_DIR, 'security.log'),
            'maxBytes': 10 * 1024 * 1024,
            'backupCount': 10,
        },
        # Emails server errors to ADMINS (or the superusers) through the
        # forum's email settings, at most once per error every 10 minutes.
        'admin_email': {
            'level': 'ERROR',
            'class': 'forum.utils.log.AdminEmailHandler',
            'formatter': 'default',
        },
    },
    'loggers': {
        'django.request': {'handlers': ['admin_email'], 'propagate': True},
        'forum.security': {'handlers': ['security_file'], 'level': 'INFO', 'propagate': True},
    },
    'root': {
        'handlers': ['file'],
        'level': 'INFO',
    },
}

#ADMINS and MANAGERS: who gets server error emails, e.g. (('Ops', 'ops@example.org'),).
# Empty: the site's superusers get them.
ADMINS = ()
MANAGERS = ADMINS

DEBUG = False

# Required. Keep it secret and unique per site; changing it logs everybody out.
# Generate one with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
SECRET_KEY = ''

# HTTPS: when APP_URL starts with https://, secure cookies and HSTS are on by
# default (see settings.py). Behind a reverse proxy (nginx, a load balancer) set
# the number of proxies so the visitor's IP and HTTPS are read from the
# X-Forwarded-For / X-Forwarded-Proto headers the proxy sets; HTTP is then
# redirected to HTTPS. Leave it 0 if visitors reach OSQA directly.
#TRUSTED_PROXY_COUNT = 1

# Sentry error reports (or the environment variables of the same names).
# SENTRY_DSN: server errors. SENTRY_FRONTEND_DSN: JavaScript errors in the
# browser; defaults to SENTRY_DSN (use a separate JavaScript project if you
# like), 'off' turns it off.
#SENTRY_DSN = 'https://<key>@o<org>.ingest.sentry.io/<project>'
#SENTRY_FRONTEND_DSN = 'https://<key>@o<org>.ingest.sentry.io/<project>'
#SENTRY_ENVIRONMENT = 'production'
#SENTRY_TRACES_SAMPLE_RATE = 0.0   # e.g. 0.1 to trace 10% of requests
DEBUG_TOOLBAR_CONFIG = {
    'INTERCEPT_REDIRECTS': True
}
TEMPLATE_DEBUG = DEBUG
INTERNAL_IPS = ('127.0.0.1',)
ALLOWED_HOSTS = ('yourhostname.com',)

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.mysql',
        'NAME': 'osqa',
        'USER': 'root',
        'PASSWORD': '',
        'HOST': '',
        'PORT': '',
        'CONN_MAX_AGE': 600,
    }
}

